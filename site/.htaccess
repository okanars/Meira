# =============================================================================
# Meira: Apache / LiteSpeed yapılandırması (site kökü)
# nginx kullanıyorsanız eşdeğer ayarlar README.md "Yayına alma" bölümündedir.
# =============================================================================

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# -----------------------------------------------------------------------------
# HTTPS ve www yönlendirmesi
# [DOĞRULANACAK] Alan adı ve SSL sertifikası kesinleşince aşağıdaki satırların başındaki # işaretini kaldırın.
# Kanonik adresler https://www. ile yazılmıştır (tools/build.mjs SITE_URL).
# -----------------------------------------------------------------------------
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} off [OR]
#   RewriteCond %{HTTP_HOST} !^www\. [NC]
#   RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
#   RewriteRule ^ https://www.%1%{REQUEST_URI} [L,R=301]
# </IfModule>

# -----------------------------------------------------------------------------
# İçerik türleri
# -----------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
  AddType application/rss+xml .xml
  AddDefaultCharset UTF-8
  AddCharset UTF-8 .html .css .js .xml .json .webmanifest .txt
</IfModule>
<Files "sitemap.xml">
  ForceType application/xml
</Files>

# -----------------------------------------------------------------------------
# Sıkıştırma
# -----------------------------------------------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/javascript application/json application/xml application/rss+xml application/manifest+json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml application/rss+xml application/manifest+json image/svg+xml
</IfModule>

# -----------------------------------------------------------------------------
# Önbellek
# CSS ve JS adresleri içerik özetiyle sürümlenir (?v=...), bu yüzden 1 yıl güvenle önbelleğe alınır.
# HTML her istekte doğrulanır; görseller ve videolar 30 gün.
# -----------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType application/rss+xml "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # ---------------------------------------------------------------------------
  # Güvenlik başlıkları
  # CSP: tüm kaynaklar kendi alan adından. Satır içi betik ve stil (JSON-LD, açılış kararı, görsel
  # kırpma için object-position) kullanıldığı için 'unsafe-inline' gereklidir.
  # ---------------------------------------------------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
  # [DOĞRULANACAK] HTTPS kesinleşip en az birkaç gün sorunsuz çalıştıktan sonra açın:
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header unset X-Powered-By
</IfModule>

# -----------------------------------------------------------------------------
# Erişime kapalı dosyalar: gizli dosyalar, form günlüğü, kaynak ve yedek dosyaları
# -----------------------------------------------------------------------------
<FilesMatch "(^\.|\.(log|md|bak|sql|sh|ini|lock)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
